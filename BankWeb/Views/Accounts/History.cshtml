@model AccountModel
@{
    ViewData["Title"] = "History " + Model.AccountNumber;
}
<a asp-action="Index" class="small">&larr; My accounts</a>
<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3 mt-2">
    <div>
        <h1 class="h3 mb-0">@Model.AccountName</h1>
        <div class="text-muted">Account @Model.AccountNumber</div>
    </div>
    <div class="text-end">
        <div class="small text-muted">Current balance</div>
        <div class="balance">@Model.Balance.ToString("C")</div>
    </div>
</div>

<input type="hidden" id="accountNumber" value="@Model.AccountNumber" />

<div class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="fromDate">From</label>
        <input type="date" id="fromDate" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="toDate">To</label>
        <input type="date" id="toDate" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-sm btn-primary" onclick="filterHistory()">Filter</button>
        <button type="button" class="btn btn-sm btn-link" onclick="clearFilter()">Clear</button>
    </div>
</div>

<div id="historyTable">
    <p class="text-muted">Loading transactions…</p>
</div>

@section Scripts {
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}