@{
    ViewData["Title"] = "My accounts";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My accounts</h1>
    <a asp-controller="Transfer" asp-action="Index" class="btn btn-primary">Transfer money</a>
</div>

<div id="accountList">
    <p class="text-muted">Loading your accounts…</p>
</div>

@section Scripts {
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}