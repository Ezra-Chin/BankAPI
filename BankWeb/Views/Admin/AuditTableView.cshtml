@* basiclaly this part is saying what they expect from the model like in View("whatever is thrown in here") *@

@model PagedResult<AuditEntry>
@{
    string error = ViewBag.Error;
}

<div id="AuditList">

    @if (error != null && error.Length > 0)
    {
        <p id="AuditError">@error</p>
    }

    <table>
        <tr>
            <th>When</th>
            <th>Admin</th>
            <th>Action</th>
            <th>Details</th>
        </tr>
        
        @foreach (AuditEntry a in Model.Items)
        {
            @* @here mean whatever in the model *@
            <tr>
                <td>@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@a.AdminUsername</td>
                <td>@a.Action</td>
                <td>@a.Details</td>
            </tr>
        }

        @if (Model.Items.Count == 0 && (error == null || error.Length == 0))
        {
            <tr><td colspan="4">No admin actions recorded yet.</td></tr>
        }
    </table>

    @if (Model.TotalPages > 0)
    {
        <div id="AuditPager">
            <p>Page @Model.Page of @Model.TotalPages (@Model.TotalCount records)</p>
            @if (Model.Page > 1)
            {
                <button type="button" onclick="goToPage(@(Model.Page - 1))">Previous</button>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <button type="button" onclick="goToPage(@(Model.Page + 1))">Next</button>
            }
        </div>
    }

</div>