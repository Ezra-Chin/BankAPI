@model UserCreateProfile
@{
    ViewData["Title"] = "Create user";
}

<p>
    <a href="/Admin/Users">&larr; Back to users</a>
</p>

<h1>Create user</h1>

<div id="CreateUserForm">
    <div>
        <form action="/Admin/CreateUser" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div>
                <label for="Username">Username</label>
                <input type="text"
                       id="Username"
                       name="Username"
                       value="@Model.Username"
                       placeholder="User Name"
                       required />
            </div>

            <div>
                <label for="Name">Name</label>
                <input type="text"
                       id="Name"
                       name="Name"
                       value="@Model.Name"
                       placeholder="Name"
                       required />
            </div>

            <div>
                <label for="Email">Email</label>
                <input type="email"
                       id="Email"
                       name="Email"
                       value="@Model.Email"
                       placeholder="Email"
                       required />
            </div>

            <div>
                <label for="Address">Address</label>
                <input type="text"
                       id="Address"
                       name="Address"
                       value="@Model.Address"
                       placeholder="Address"
                       required />
            </div>

            <div>
                <label for="Phone">Phone</label>
                <input type="text"
                       id="Phone"
                       name="Phone"
                       value="@Model.Phone"
                       placeholder="Phone"
                       required />
            </div>

            <div>
                <label for="Password">Password</label>
                <input type="password"
                       id="Password"
                       name="Password"
                       placeholder="Password"
                       required />
            </div>

            <div>
                <label for="Picture">Profile picture (optional)</label>
                <input type="file"
                       id="Picture"
                       name="Picture"
                       accept=".jpg, .jpeg, .png" />
            </div>

            <input type="submit" value="Create user" />

            <a href="/Admin/Users">Cancel</a>
        </form>
    </div>
</div>
