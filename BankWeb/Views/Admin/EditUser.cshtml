```cshtml
@model UserUpdateProfile
@{
    ViewData["Title"] = "Edit user";
    string username = ViewBag.Username;
}

<p>
    <a href="/Admin/Users">&larr; Back to users</a>
</p>

<h1>Edit @username</h1>

<div>
    <div>
        <div id="EditUserForm">
            <div>
                <h2>Contact details</h2>

                <form action="/Admin/EditUser/@username" method="post">
                    @Html.AntiForgeryToken()

                    <div>
                        <label for="Name">Name</label>
                        <input type="text"
                               id="Name"
                               name="Name"
                               value="@Model.Name"
                               required />
                    </div>

                    <div>
                        <label for="Email">Email</label>
                        <input type="email"
                               id="Email"
                               name="Email"
                               value="@Model.Email"
                               required />
                    </div>

                    <div>
                        <label for="Address">Address</label>
                        <input type="text"
                               id="Address"
                               name="Address"
                               value="@Model.Address"
                               required />
                    </div>

                    <div>
                        <label for="Phone">Phone</label>
                        <input type="text"
                               id="Phone"
                               name="Phone"
                               value="@Model.Phone"
                               required />
                    </div>

                    <input type="submit" value="Save changes" />
                </form>
            </div>
        </div>
    </div>

    <div>
        <div id="ResetPasswordForm">
            <div>
                <h2>Reset password</h2>

                <form action="/Admin/ResetPassword/@username" method="post">
                    @Html.AntiForgeryToken()

                    <div>
                        <label for="newPassword">New password</label>
                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               placeholder="At least 6 characters"
                               minlength="6"
                               required />
                    </div>

                    <input type="submit" value="Reset password" />
                </form>
            </div>
        </div>
    </div>
</div>
```