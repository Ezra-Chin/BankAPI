@model List<AuditEntry>
@{
    ViewData["Title"] = "Admin dashboard";
    int? totalUsers = ViewBag.TotalUsers;
    int? activeUsers = ViewBag.ActiveUsers;
    int? deactivatedUsers = null;

    if (totalUsers != null && activeUsers != null)
    {
        deactivatedUsers = totalUsers - activeUsers;
    }

    string error = ViewBag.Error;
}

<h1>Administrator dashboard</h1>

<div>
    <div>
        <div>
            <h2>Total users</h2>
            <div>Customers and administrators</div>
            <div>@(totalUsers == null ? "-" : totalUsers.ToString())</div>
        </div>

        <div>
            <a href="/Admin/Users">Manage users</a>
            <a href="/Admin/CreateUser">Create user</a>
        </div>
    </div>

    <div>
        <div>
            <h2>Active users</h2>
            <div>Can sign in</div>
            <div>@(activeUsers == null ? "-" : activeUsers.ToString())</div>
        </div>

        <div>
            <a href="/Admin/Transactions">All transactions</a>
        </div>
    </div>

    <div>
        <div>
            <h2>Deactivated users</h2>
            <div>Blocked from signing in</div>
            <div>@(deactivatedUsers == null ? "-" : deactivatedUsers.ToString())</div>

            @if (deactivatedUsers != null && deactivatedUsers > 0)
            {
                <span>Needs review</span>
            }
        </div>

        <div>
            <a href="/Profile">My profile</a>
        </div>
    </div>
</div>

<h2>Recent admin actions</h2>

<p>
    <a href="/Admin/AuditTrail">View full audit trail</a>
</p>

@if (Model.Count == 0 && (error == null || error.Length == 0))
{
    <p>No admin actions recorded yet.</p>
}

<div>
    @foreach (var entry in Model)
    {
        <div>
            <div>
                <h2>@entry.Action</h2>
                <div>By <strong>@entry.AdminUsername</strong></div>
                <div>@entry.Details</div>
            </div>

            <div>
                @entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    }
</div>
