@model TransactionHistoryViewModel
@{
    string error = ViewBag.Error;
    TransactionFilter filter = Model.Filter;
    PagedResult<TransactionModel> result = Model.Result;

    //show an arrow next to the column being sorted
    string arrow = " ▼";
    if (filter.SortDir == "asc")
    {
        arrow = " ▲";
    }
    string dateArrow = "";
    string typeArrow = "";
    string amountArrow = "";
    if (filter.SortBy == "date") { dateArrow = arrow; }
    if (filter.SortBy == "type") { typeArrow = arrow; }
    if (filter.SortBy == "amount") { amountArrow = arrow; }
}

<div id="TransactionsList">

    @if (error != null && error.Length > 0)
    {
        <p id="TransactionsError">@error</p>
    }

    <table>
        <tr>
            <th><button type="button" onclick="sortTransactions('date')">Date@dateArrow</button></th>
            <th>User</th>
            <th>Account</th>
            <th><button type="button" onclick="sortTransactions('type')">Type@typeArrow</button></th>
            <th>Description</th>
            <th>Other account</th>
            <th><button type="button" onclick="sortTransactions('amount')">Amount@amountArrow</button></th>
        </tr>

        @foreach (TransactionModel t in result.Items)
        {
            string sign = "-";
            if (t.IsCredit)
            {
                sign = "+";
            }
            string otherAccount = "-";
            if (t.RelatedAccountNumber != null)
            {
                otherAccount = t.RelatedAccountNumber;
            }

            <tr>
                <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@t.Username</td>
                <td>@t.AccountNumber</td>
                <td>@t.Type</td>
                <td>@t.Description</td>
                <td>@otherAccount</td>
                <td>@sign@t.Amount.ToString("C")</td>
            </tr>
        }

        @if (result.Items.Count == 0 && (error == null || error.Length == 0))
        {
            <tr><td colspan="7">No transactions match these filters.</td></tr>
        }
    </table>

    @if (result.TotalPages > 0)
    {
        <div id="TransactionsPager">
            <p>Page @result.Page of @result.TotalPages (@result.TotalCount records)</p>
            @if (result.Page > 1)
            {
                <button type="button" onclick="goToPage(@(result.Page - 1))">Previous</button>
            }
            @if (result.Page < result.TotalPages)
            {
                <button type="button" onclick="goToPage(@(result.Page + 1))">Next</button>
            }
        </div>
    }

</div>