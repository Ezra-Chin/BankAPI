@{
    ViewData["Title"] = "Welcome";
}
<div class="row align-items-center py-5">
    <div class="col-md-7">
        <h1 class="display-6 fw-semibold">Online banking</h1>
        <p class="lead text-muted">View your accounts and transaction history, and move money between accounts.</p>
        <a class="btn btn-primary btn-lg me-2" asp-controller="Auth" asp-action="Login">Sign in</a>
        <a class="btn btn-outline-primary btn-lg" asp-controller="Auth" asp-action="Register">Open an account</a>
    </div>
</div>