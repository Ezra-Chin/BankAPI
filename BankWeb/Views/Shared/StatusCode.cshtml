@{
    int code = ViewBag.Code ?? 0;
    ViewData["Title"] = code == 404 ? "Not found" : "Error " + code;
}
<div class="text-center py-5">
    @if (code == 404)
    {
        <h1 class="h3">Page not found</h1>
        <p class="text-muted">The page or record you asked for does not exist, or you do not have access to it.</p>
    }
    else if (code == 403)
    {
        <h1 class="h3">Access denied</h1>
        <p class="text-muted">You do not have permission to view this page.</p>
    }
    else
    {
        <h1 class="h3">Something went wrong (@code)</h1>
        <p class="text-muted">Please try again.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>