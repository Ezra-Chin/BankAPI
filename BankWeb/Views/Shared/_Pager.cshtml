@model PagerModel
@if (Model.TotalPages > 1)
{
    int first = Math.Max(1, Model.Page - 2);
    int last = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Pages" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted small">Page @Model.Page of @Model.TotalPages (@Model.TotalCount records)</span>
        <div class="btn-group btn-group-sm">
            @if (Model.Page > 1)
            {
                <button type="button" class="btn btn-outline-primary" onclick="goToPage(@(Model.Page - 1))">Previous</button>
            }
            @for (int p = first; p <= last; p++)
            {
                <button type="button" class="btn @(p == Model.Page ? "btn-primary" : "btn-outline-primary")" onclick="goToPage(@p)">@p</button>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <button type="button" class="btn btn-outline-primary" onclick="goToPage(@(Model.Page + 1))">Next</button>
            }
        </div>
    </nav>
}
else
{
    <p class="text-muted small">@Model.TotalCount record(s)</p>
}